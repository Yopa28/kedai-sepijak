# ============================================
# Environment Variables Configuration
# Kedai Sepijak Backend (Aiven Configuration)
# ============================================

# Server Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# --- KONFIGURASI DATABASE AIVEN (DIUBAH) ---
DB_HOST=mysql-1fec60bd-kedaisepijak28.h.aivencloud.com
DB_PORT=25964
DB_USER=avnadmin
# PENTING: Masukkan password BARU yang sudah kamu reset di Aiven
DB_PASSWORD=AVNS_tlp0YDOEVqHZlWYCwVt
DB_NAME=defaultdb


# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# API Configuration
API_VERSION=v1
API_PREFIX=/api

# Security
JWT_SECRET=rahasia-dapur-sepijak-ganti-ini-nanti
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Account Lock
MAX_FAILED_ATTEMPTS=3 
LOCKOUT_MINUTES=15

# Logging
LOG_LEVEL=debug
LOG_FILE_PATH=./logs

# CAPTCHA
RECAPTCHA_SECRET=<secret-key>
CAPTCHA_THRESHOLD=2

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=Kedai Sepijak <noreply@kedaisepijak.com>

# Admin Configuration
ADMIN_EMAIL=admin@kedaisepijak.com
ADMIN_PASSWORD=changethispassword

# Application Settings
APP_NAME=Kedai Sepijak API
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173