{
    "builds": [
        {
            "src": "frontend/package.json",
            "config": {
                "distDir": "dist",
                "buildCommand": "npm run build"
            }
        },
        {
            "src": "api/index.js",
            "use": "@vercel/node"
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.js"
        },
        {
            "source": "/(.*)",
            "destination": "/frontend/dist/index.html"
        }
    ]
}